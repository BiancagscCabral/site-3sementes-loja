# Banco de dados PostgreSQL (Supabase)
# DATABASE_URL: pooler em modo transaction (porta 6543) - usada em runtime pelo app
DATABASE_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: pooler em modo session (porta 5432) - usada pelo Prisma para migrations
DIRECT_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# InfinitePay - Checkout Integrado
# Sua InfiniteTag (usuário do App InfinitePay, SEM o símbolo $)
INFINITEPAY_HANDLE="sua_infinite_tag"

# SuperFrete - token de API
# Gerado em: https://web.superfrete.com/ > Integração > Nova Integração > "Site próprio"
# Use o token de Sandbox primeiro para testar sem gerar etiquetas reais
SUPERFRETE_TOKEN="seu_token_aqui"
SUPERFRETE_ENV="sandbox" # troque para "production" quando for para o ar de verdade

# CEP de origem da loja, usado para calcular o frete
STORE_ORIGIN_ZIPCODE="00000000"

# Supabase Auth (login do painel ADM e das clientes)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_publica
# E-mails que enxergam o painel de pedidos (separados por virgula)
ADMIN_EMAIL=seu_email@exemplo.com

# Endereco publico do site, usado nos links de retorno e no webhook de pagamento
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br
