{
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npx tsc --noEmit*)"
    ],
    "ask": [
      "Bash(npm run db:push*)",
      "Bash(npm run db:migrate*)",
      "Bash(npm run db:seed*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma migrate*)",
      "Bash(npx prisma db seed*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-arquivo.mjs\""
          }
        ]
      }
    ]
  }
}
