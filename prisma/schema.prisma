// Schema do banco de dados da loja 3sementes & 3sflores
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Categoria de produto (ex: "Vasos de cerâmica", "Buquês secos", "Bordados")
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// Produto artesanal vendido na loja
model Product {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  description    String
  priceCents     Int // preço em centavos, evita problemas de arredondamento com float
  images         ProductImage[]
  variants       ProductVariant[]
  sizes          String[]         @default([]) // ex: ["P", "M", "G", "GG"]
  colors         String[]         @default([]) // ex: ["Dourado", "Prata"]
  optionLabel    String? // rótulo da lista acima quando não é cor (ex: "Tema")
  allowsGiftCard Boolean          @default(false) // mostra na página que o pedido pode levar card polaroid ou cartão presente
  stock          Int              @default(0) // estoque padrão, usado se não houver variantes
  weightGrams    Int? // peso em gramas, necessário para cotação de frete (SuperFrete)
  heightCm       Float?
  widthCm        Float?
  lengthCm       Float?
  category       Category         @relation(fields: [categoryId], references: [id])
  categoryId     String
  active         Boolean          @default(true)
  orderItems     OrderItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

// Fotos do produto (galeria)
model ProductImage {
  id         String  @id @default(cuid())
  url        String
  altText    String?
  position   Int     @default(0)
  optionName String? // foto de uma opção específica (ex: o tema "Cinderela")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
}

// Variante do produto (ex: cor, tamanho) — opcional, nem todo produto precisa ter
model ProductVariant {
  id         String  @id @default(cuid())
  name       String // ex: "Azul", "P", "300ml"
  priceCents Int? // se null, usa o preço do produto
  stock      Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
}

// Pedido feito por um cliente
model Order {
  id               String  @id @default(cuid())
  code             String  @unique // código curto que a cliente usa para acompanhar (ex: 3S-K7P2QX)
  // Conta da cliente no Supabase Auth, quando ela estava logada ao comprar.
  // Pedido feito sem conta fica nulo e é reconhecido depois pelo e-mail.
  customerUserId   String?
  customerName     String
  customerEmail    String?
  customerPhone    String
  // CPF ou CNPJ de quem recebe. A SuperFrete exige o documento da
  // destinatária para emitir a etiqueta. Guardado só com os dígitos, sem
  // pontuação, para não depender de como a pessoa digitou.
  customerDocument String?
  shippingAddress  Json // CEP, rua, número, bairro, cidade, estado, complemento

  // Frete
  deliveryMethod  String? // "correios" | "uber-flash"
  shippingCents   Int? // nulo quando o valor é combinado por fora (Uber Flash)
  shippingService String? // ex: "PAC", "SEDEX", "Uber Flash"

  // Pagamento (InfinitePay)
  infinitePayOrderNsu String?       @unique // seu identificador do pedido, enviado à InfinitePay
  infinitePaySlug     String? // slug do link de checkout retornado pela API
  paymentStatus       PaymentStatus @default(PENDING)
  paidAmountCents     Int?
  paymentMethod       String? // "pix" | "credit_card"

  // Rastreio. Guarda o que a loja colar: o código dos Correios sozinho
  // (DG048745602BR) ou o link que a SuperFrete dá quando a etiqueta é postada.
  // Aceitar os dois evita obrigar a loja a extrair o código de dentro do link.
  tracking String?

  status     OrderStatus  @default(AWAITING_PAYMENT)
  items      OrderItem[]
  events     OrderEvent[]
  totalCents Int
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([customerUserId])
  @@index([customerEmail])
}

model OrderItem {
  id             String  @id @default(cuid())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        Product @relation(fields: [productId], references: [id])
  productId      String
  // Nome e variação são copiados na hora da compra: se o produto for renomeado
  // ou sair do ar depois, o pedido antigo continua legível.
  productName    String
  variantName    String?
  size           String? // P, M, G, GG — guardado separado porque muda o preço
  variantId      String?
  quantity       Int
  unitPriceCents Int // preço no momento da compra (não muda se o preço do produto mudar depois)
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  AWAITING_CONTACT // veio pelo site e será fechado pelo WhatsApp
  AWAITING_PAYMENT
  PAID // o dinheiro entrou, a peça ainda não começou
  IN_PRODUCTION // a peça está sendo feita
  SHIPPED
  DELIVERED
  CANCELLED
}

// Cada passo que o pedido deu, com a hora em que deu.
//
// Sem isto o pedido só sabe dizer onde está agora, nunca quando chegou ali, e
// a cliente ficaria com uma trilha sem datas. Guardar os passos em linhas
// separadas, em vez de uma coluna de data por situação, significa que criar
// uma situação nova no futuro não exige mexer na tabela de pedidos.
model OrderEvent {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  status OrderStatus
  // Quem causou: "sistema" quando foi o pagamento confirmado sozinho, ou o
  // e-mail da administradora quando foi mudado na mão pelo painel.
  origem String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}
